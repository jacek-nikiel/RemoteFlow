{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "remoteflow",
  "version": "1.16.0",
  "identifier": "com.remoteflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteFlow",
        "width": 920,
        "height": 640,
        "minWidth": 800,
        "minHeight": 550,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: ws://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jacek Nikiel",
    "copyright": "Copyright (c) 2026 Jacek Nikiel",
    "license": "MIT",
    "homepage": "https://github.com/jacek-nikiel/RemoteFlow",
    "category": "DeveloperTool",
    "shortDescription": "SSH, SFTP and RDP connection manager",
    "longDescription": "Cross-platform SSH, SFTP and RDP connection manager with an encrypted local vault, split-screen workspace and mRemoteNG import.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMDc0QUY4QjE1NzcyMTQKUldRVWNsZXgrRW9ISVB2QlM3dlMybFJSajh3M0ZQWnhOeWgwSlFZY3RyOFZubXRWWmw3U3BGTmEK",
      "endpoints": [
        "https://github.com/jacek-nikiel/RemoteFlow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
