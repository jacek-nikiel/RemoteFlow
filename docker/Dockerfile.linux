#
# Builds the Linux version of RemoteFlow (binary + .deb + .rpm + .AppImage) in a container,
# so it can be produced from Windows (Docker Desktop) or any other system.
#
#   docker build -f docker/Dockerfile.linux --target export --output type=local,dest=dist-linux .
#
# Ubuntu 22.04 is used on purpose: its older glibc (2.35) makes the binary run on more distros.

FROM ubuntu:22.04 AS source

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    # linuxdeploy (AppImage) cannot use FUSE inside a container
    APPIMAGE_EXTRACT_AND_RUN=1 \
    NO_STRIP=true

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl wget file pkg-config xdg-utils patchelf libarchive-tools zstd \
        libssl-dev libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev \
        libjavascriptcoregtk-4.1-dev librsvg2-dev libayatana-appindicator3-dev libxdo-dev \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable

# AppImage tools that `tauri build` would otherwise download from GitHub on every build (a GitHub
# error such as "http status: 504" then failed the whole build). Downloaded once with retries into
# the cache directory where the Tauri CLI looks for them (~/.cache/tauri), kept in this layer.
# The file names/URLs match the bundler of @tauri-apps/cli 2.x (linuxdeploy commit 07333c6); if a
# newer CLI expects other versions, it downloads them itself as before.
ARG LINUXDEPLOY_COMMIT=07333c6
RUN set -eux; \
    dir=/root/.cache/tauri; mkdir -p "$dir"; \
    get() { curl -fsSL --retry 10 --retry-all-errors --retry-delay 5 --connect-timeout 30 -o "$2.part" "$1" && mv "$2.part" "$2" && chmod +x "$2"; }; \
    get https://github.com/tauri-apps/binary-releases/releases/download/apprun-old/AppRun-x86_64 "$dir/AppRun-x86_64"; \
    get https://github.com/tauri-apps/binary-releases/releases/download/linuxdeploy-${LINUXDEPLOY_COMMIT}/linuxdeploy-x86_64.AppImage "$dir/linuxdeploy-${LINUXDEPLOY_COMMIT}-x86_64.AppImage"; \
    get https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage "$dir/linuxdeploy-plugin-appimage.AppImage" \
      || echo "linuxdeploy-plugin-appimage not downloaded - linuxdeploy uses its built-in version"; \
    ls -la "$dir"

WORKDIR /app

# Dependencies first (better layer caching). node_modules from the host is NOT used
# (see .dockerignore) – native npm modules must be installed for Linux.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

FROM source AS verify
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/src-tauri/target \
    npm run build && cd src-tauri && cargo test --lib --locked

FROM source AS build
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/src-tauri/target \
    npm run tauri build -- --bundles deb,rpm,appimage \
    && mkdir -p /out \
    && cp src-tauri/target/release/remoteflow /out/remoteflow \
    && cp scripts/install-linux-desktop.sh /out/install-linux-desktop.sh \
    && cp src-tauri/icons/icon.png /out/remoteflow.png \
    && cp src-tauri/target/release/bundle/deb/*.deb /out/ \
    && cp src-tauri/target/release/bundle/rpm/*.rpm /out/ \
    && cp src-tauri/target/release/bundle/appimage/*.AppImage /out/ \
    && bash scripts/build-arch-pkg.sh src-tauri/target/release/remoteflow /out

# Only the build results end up in the output directory.
FROM scratch AS export
COPY --from=build /out/ /
